// ---------- Tokens ----------
// Daily tokens per model (fct_model_day). Shares use ALL tokens as the denominator, including the long tail.

Total Tokens = SUM ( fct_model_day[tokens] )

All Tokens = CALCULATE ( [Total Tokens], REMOVEFILTERS ( dim_model ), REMOVEFILTERS ( dim_lab ) )

Token Share = DIVIDE ( [Total Tokens], [All Tokens] )

Data Days = CALCULATE ( COUNTROWS ( dim_date ), dim_date[is_missing_day] == FALSE () )

Tokens per Day (T) = DIVIDE ( [Total Tokens], [Data Days] ) / 1E12

China Token Share = CALCULATE ( [Token Share], dim_lab[country_group] = "China" )

US Token Share = CALCULATE ( [Token Share], dim_lab[country_group] = "US" )

Lab HHI =
VAR NamedTokens = CALCULATE ( [Total Tokens], NOT dim_lab[org_type] IN { "stealth", "long_tail", "pending" } )
VAR Labs = CALCULATETABLE ( VALUES ( dim_lab[org_name] ), NOT dim_lab[org_type] IN { "stealth", "long_tail", "pending" } )
RETURN 10000 * SUMX ( Labs, DIVIDE ( CALCULATE ( [Total Tokens] ), NamedTokens ) ^ 2 )

// ---------- Spend ----------
// Monthly model facts (mart_model_month) at that month's list price. Estimated spend is an upper bound; use shares.

Month Tokens = SUM ( mart_model_month[tokens] )

Month Token Share = DIVIDE ( [Month Tokens], CALCULATE ( [Month Tokens], REMOVEFILTERS ( dim_model ), REMOVEFILTERS ( dim_lab ) ) )

Est Spend = SUM ( mart_model_month[est_spend_usd] )

Est Spend 3to1 = SUM ( mart_model_month[est_spend_usd_3to1] )

Spend Share = DIVIDE ( [Est Spend], CALCULATE ( [Est Spend], REMOVEFILTERS ( dim_model ), REMOVEFILTERS ( dim_lab ) ) )

Spend Share 3to1 = DIVIDE ( [Est Spend 3to1], CALCULATE ( [Est Spend 3to1], REMOVEFILTERS ( dim_model ), REMOVEFILTERS ( dim_lab ) ) )

Priced Tokens = CALCULATE ( [Month Tokens], NOT ISBLANK ( mart_model_month[est_spend_usd] ) )

Avg Price Paid = DIVIDE ( [Est Spend], [Priced Tokens] ) * 1E6

China Spend Share = CALCULATE ( [Spend Share], dim_lab[country_group] = "China" )

US Spend Share = CALCULATE ( [Spend Share], dim_lab[country_group] = "US" )

// ---------- Charts ----------
// Fixed-period versions the report pages show (the pricing page is a September 2026 snapshot).

Token Share Sep 2026 = CALCULATE ( [Month Token Share], dim_month[month] = DATE ( 2026, 9, 1 ) )

Spend Share Sep 2026 = CALCULATE ( [Spend Share], dim_month[month] = DATE ( 2026, 9, 1 ) )

Lab HHI (full months) = IF ( SELECTEDVALUE ( dim_month[is_partial] ) = FALSE (), [Lab HHI] )

Highly Concentrated Line = IF ( NOT ISBLANK ( [Lab HHI (full months)] ), 1800 )

// ---------- Robustness ----------

Robustness Result = SELECTEDVALUE ( chart_robustness[Result] )
