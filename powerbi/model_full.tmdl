						Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = "Ajay0704/ai-model-market/main/data/processed/dim_month.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Headers, {{"month", type date}, {"month_label", type text}, {"month_sort", Int64.Type}, {"data_days", Int64.Type}, {"is_partial", type logical}}, "en-US")
					in
						Typed

