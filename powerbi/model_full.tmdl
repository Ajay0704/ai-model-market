			sourceColumn: month_label
			sortByColumn: month_sort

		column month_sort
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: month_sort

		column data_days
			dataType: int64
			summarizeBy: none
			sourceColumn: data_days

		column is_partial
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_partial

		partition dim_month = m
