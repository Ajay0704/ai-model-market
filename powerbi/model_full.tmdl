		partition chart_labs_tokens_spend = m
			mode: import
			source =
					let
						Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = "Ajay0704/ai-model-market/main/tableau/data/labs_tokens_spend.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Headers, {{"Lab", type text}, {"Spend Rank", Int64.Type}, {"Measure", type text}, {"Share", type number}}, "en-US")
					in
						Typed

	relationship fct_model_day_date__dim_date
		fromColumn: fct_model_day.date
		toColumn: dim_date.date

	relationship dim_date_month__dim_month
		fromColumn: dim_date.month
		toColumn: dim_month.month

	relationship fct_model_day_model_permaslug__dim_model
		fromColumn: fct_model_day.model_permaslug
		toColumn: dim_model.model_permaslug

	relationship dim_model_org_name__dim_lab
		fromColumn: dim_model.org_name
		toColumn: dim_lab.org_name

	relationship mart_model_month_month__dim_month
		fromColumn: mart_model_month.month
		toColumn: dim_month.month

	relationship mart_model_month_model_permaslug__dim_model
		fromColumn: mart_model_month.model_permaslug
		toColumn: dim_model.model_permaslug

