			dataType: string
			summarizeBy: none
			sourceColumn: hugging_face_id

		column first_seen_date
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: first_seen_date

		column last_seen_date
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: last_seen_date

		column days_in_top50
			dataType: int64
			summarizeBy: none
			sourceColumn: days_in_top50

		partition dim_model = m
			mode: import
			source =
					let
						Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = "Ajay0704/ai-model-market/main/data/processed/dim_model.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Headers, {{"model_permaslug", type text}, {"prefix", type text}, {"base_slug", type text}, {"model_family", type text}, {"variant", type text}, {"is_free_variant", type logical}, {"is_stealth", type logical}, {"org_name", type text}, {"display_name", type text}, {"listed_date", type date}, {"context_length", Int64.Type}, {"open_weights", type logical}, {"hugging_face_id", type text}, {"first_seen_date", type date}, {"last_seen_date", type date}, {"days_in_top50", Int64.Type}}, "en-US")
					in
						Typed

	table fct_model_day

		measure 'Total Tokens' = SUM ( fct_model_day[tokens] )
			formatString: #,0
			displayFolder: Tokens

		measure 'All Tokens' = CALCULATE ( [Total Tokens], REMOVEFILTERS ( dim_model ), REMOVEFILTERS ( dim_lab ) )
			formatString: #,0
			displayFolder: Tokens

		measure 'Token Share' = DIVIDE ( [Total Tokens], [All Tokens] )
			formatString: 0.0%
			displayFolder: Tokens

		measure 'Data Days' = CALCULATE ( COUNTROWS ( dim_date ), dim_date[is_missing_day] == FALSE () )
			formatString: #,0
			displayFolder: Tokens

		measure 'Tokens per Day (T)' = DIVIDE ( [Total Tokens], [Data Days] ) / 1E12
			formatString: #,0.0
			displayFolder: Tokens

		measure 'China Token Share' = CALCULATE ( [Token Share], dim_lab[country_group] = "China" )
			formatString: 0.0%
			displayFolder: Tokens

		measure 'US Token Share' = CALCULATE ( [Token Share], dim_lab[country_group] = "US" )
			formatString: 0.0%
			displayFolder: Tokens

		measure 'Lab HHI' = ```
				VAR NamedTokens = CALCULATE ( [Total Tokens], NOT dim_lab[org_type] IN { "stealth", "long_tail", "pending" } )
				VAR Labs = CALCULATETABLE ( VALUES ( dim_lab[org_name] ), NOT dim_lab[org_type] IN { "stealth", "long_tail", "pending" } )
				RETURN 10000 * SUMX ( Labs, DIVIDE ( CALCULATE ( [Total Tokens] ), NamedTokens ) ^ 2 )
				```
			formatString: #,0
			displayFolder: Tokens

		column date
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: date

		column model_permaslug
			dataType: string
			summarizeBy: none
			sourceColumn: model_permaslug

		column tokens
			dataType: int64
			summarizeBy: sum
			sourceColumn: tokens

		partition fct_model_day = m
			mode: import
			source =
					let
						Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = "Ajay0704/ai-model-market/main/data/processed/fct_model_day.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Headers, {{"date", type date}, {"model_permaslug", type text}, {"tokens", Int64.Type}}, "en-US")
					in
						Typed

	table mart_model_month

		measure 'Month Tokens' = SUM ( mart_model_month[tokens] )
			formatString: #,0
			displayFolder: Spend

		measure 'Month Token Share' = DIVIDE ( [Month Tokens], CALCULATE ( [Month Tokens], REMOVEFILTERS ( dim_model ), REMOVEFILTERS ( dim_lab ) ) )
			formatString: 0.0%
			displayFolder: Spend

		measure 'Est Spend' = SUM ( mart_model_month[est_spend_usd] )
			formatString: \$#,0
			displayFolder: Spend

		measure 'Est Spend 3to1' = SUM ( mart_model_month[est_spend_usd_3to1] )
			formatString: \$#,0
			displayFolder: Spend

		measure 'Spend Share' = DIVIDE ( [Est Spend], CALCULATE ( [Est Spend], REMOVEFILTERS ( dim_model ), REMOVEFILTERS ( dim_lab ) ) )
			formatString: 0.0%
			displayFolder: Spend

		measure 'Spend Share 3to1' = DIVIDE ( [Est Spend 3to1], CALCULATE ( [Est Spend 3to1], REMOVEFILTERS ( dim_model ), REMOVEFILTERS ( dim_lab ) ) )
			formatString: 0.0%
			displayFolder: Spend

		measure 'Priced Tokens' = CALCULATE ( [Month Tokens], NOT ISBLANK ( mart_model_month[est_spend_usd] ) )
			formatString: \$#,0.00
			displayFolder: Spend

		measure 'Avg Price Paid' = DIVIDE ( [Est Spend], [Priced Tokens] ) * 1E6
			formatString: \$#,0.00
			displayFolder: Spend

		measure 'China Spend Share' = CALCULATE ( [Spend Share], dim_lab[country_group] = "China" )
			formatString: 0.0%
			displayFolder: Spend

		measure 'US Spend Share' = CALCULATE ( [Spend Share], dim_lab[country_group] = "US" )
			formatString: 0.0%
			displayFolder: Spend

		measure 'Token Share Sep 2026' = CALCULATE ( [Month Token Share], dim_month[month] = DATE ( 2026, 9, 1 ) )
			formatString: 0.0%
			displayFolder: Charts

		measure 'Spend Share Sep 2026' = CALCULATE ( [Spend Share], dim_month[month] = DATE ( 2026, 9, 1 ) )
			formatString: 0.0%
			displayFolder: Charts

		measure 'Lab HHI (full months)' = IF ( SELECTEDVALUE ( dim_month[is_partial] ) = FALSE (), [Lab HHI] )
			formatString: #,0
			displayFolder: Charts

		measure 'Highly Concentrated Line' = IF ( NOT ISBLANK ( [Lab HHI (full months)] ), 1800 )
			formatString: #,0
			displayFolder: Charts

		column month
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: month

		column model_permaslug
			dataType: string
			summarizeBy: none
			sourceColumn: model_permaslug

		column tokens
