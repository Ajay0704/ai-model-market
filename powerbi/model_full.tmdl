			summarizeBy: none
			sourceColumn: price_tier

		partition mart_model_month = m
			mode: import
			source =
					let
						Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = "Ajay0704/ai-model-market/main/data/processed/mart_model_month.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Headers, {{"month", type date}, {"model_permaslug", type text}, {"tokens", Int64.Type}, {"days_in_top50", Int64.Type}, {"avg_tokens_per_day", type number}, {"token_share", type number}, {"blended_price_per_m", type number}, {"est_spend_usd", type number}, {"est_spend_usd_3to1", type number}, {"price_match", type text}, {"price_tier", type text}}, "en-US")
					in
						Typed

